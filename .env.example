# Leave DATABASE_URL unset for the explicitly labelled local development database.
# Set this locally to a Tiger Cloud PostgreSQL URL; never commit the real value.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=verify-full
PORT=4318
HOST=127.0.0.1
# Model weights and uploaded source attachments are kept here and ignored by git.
DATA_DIR=.data

# Optional PEM for a provider private CA, obtained and authenticated separately.
# DATABASE_SSL_CA=.data/tls/provider-ca.pem
